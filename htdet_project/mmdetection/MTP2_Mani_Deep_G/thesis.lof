\contentsline {figure}{\numberline {3.4}{\ignorespaces Per-class AP (IoU 0.50:0.95) across channel reduction variants. Scallop is the most compression-sensitive class; echinus and starfish retain accuracy well.}}{21}%
\contentsline {figure}{\numberline {3.5}{\ignorespaces Per-layer weight SQNR for W8A32 PTQ on the 192-channel model. FPN and head layers (orange/green) show $\infty $\tmspace +\thinmuskip {.1667em}dB SQNR where quantization is lossless. All backbone layers exceed 35\tmspace +\thinmuskip {.1667em}dB.}}{22}%
\contentsline {figure}{\numberline {3.6}{\ignorespaces W8A32 vs W8A8 on the 192-channel model: SQNR distribution (left), formal mAP$_{50}$ comparison (centre), detection count at score $\geq 0.20$ (right).}}{24}%
\contentsline {figure}{\numberline {3.7}{\ignorespaces Qualitative detection results on URPC validation images (score $\geq $ 0.50, baseline model). Bounding boxes colour-coded by class: \leavevmode {\color {red}holothurian}, \leavevmode {\color {blue}echinus}, \leavevmode {\color {green}scallop}, \leavevmode {\color {orange}starfish}. All six images show clean, well-separated detections across diverse underwater scenes.}}{25}%
\contentsline {figure}{\numberline {3.8}{\ignorespaces Compression study: mAP$_{50}$ vs GFLOPs scatter (left) and per-variant bar chart (right).}}{26}%
